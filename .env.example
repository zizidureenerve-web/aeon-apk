# ─── Moteur de similarité (optionnel) ───────────────────────────────
# Sans aucune clé, le jeu tourne avec un repli lexical local.
# Pour la vraie proximité SÉMANTIQUE, renseignez l'une des options :

# Option 1 — NVIDIA NIM
# NVIDIA_NIM_API_KEY=nvapi-xxxxxxxx
# NVIDIA_NIM_MODEL=nvidia/nv-embedqa-e5-v5
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Option 2 — N'importe quel endpoint compatible OpenAI (OpenAI, OpenRouter, etc.)
# EMBEDDINGS_API_KEY=sk-xxxxxxxx
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# Port du serveur
# PORT=3000
